    <script>
        console.log("AUF2026 Centered Editorial Engine initialized.");

        // Inversione logica istantanea dei contrasti cromatici (Light/Dark Mode) via variabili CSS
        function toggleEditorialTheme() {
            const rootElement = document.documentElement;
            const currentTheme = rootElement.getAttribute('data-theme');
            const targetTheme = (currentTheme === 'dark') ? 'light' : 'dark';
            rootElement.setAttribute('data-theme', targetTheme);
            console.log("Theme modificato localmente: " + targetTheme);
        }

        const pageRoutes = {
            'main_results': 'main_results.html',
            'water_anomaly': 'water_anomaly.html',
            'fine_structure': 'fine_structure.html',
            'fdm_dynamics': 'fdm_dynamics.html'
        };

        function updateTrackingUI(pageKey) {
            const menuItems = document.querySelectorAll('#tracking-menu .menu-item');
            const targetIndex = Object.keys(pageRoutes).indexOf(pageKey);
            menuItems.forEach((item, index) => {
                if (index === targetIndex) { item.classList.add('active'); } 
                else { item.classList.remove('active'); }
            });
            document.getElementById('matrix-page-selector').value = pageKey;
        }

        // Sistema di caricamento frammenti asincroni AJAX localizzato in /pages
        function loadMatrixSector(pageKey) {
            updateTrackingUI(pageKey);
            const targetUrl = './pages/' + pageRoutes[pageKey];
            fetch(targetUrl)
                .then(response => {
                    if (!response.ok) throw new Error("Initializing sector data inside /pages...");
                    return response.text();
                })
                .then(htmlContent => {
                    document.getElementById('content-container').innerHTML = htmlContent;
                })
                .catch(error => { console.log(error.message); });
        }

        function navigateViaMenu(pageKey) { loadMatrixSector(pageKey); }
    </script>

