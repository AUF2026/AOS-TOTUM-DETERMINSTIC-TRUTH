<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AUF2026 Framework — AOS144-HDFP</title>
    <style>
        /* AUF2026 Editorial Design Tokens — Variable Systems */
        :root {
            /* Light Theme (Default: Pure White, Sharp Black, Gold Accents) */
            --bg-master: #ffffff;
            --bg-surface: #fafafa;
            --bg-code: #f5f5f7;
            --border-pure: #111111;
            --border-subtle: #e5e5e7;
            --text-master: #111111;
            --text-muted: #555555;
            --gold-logo: #c5a028;
            --gold-glow: rgba(197, 160, 40, 0.06);
            --font-editorial: 'Times New Roman', Georgia, serif;
            --font-mono: 'SF Mono', 'Fira Code', 'Courier New', monospace;
        }

        [data-theme="dark"] {
            /* Dark Theme (Inverted: Absolute Black, Sharp White, Bright Gold) */
            --bg-master: #0b0b0c;
            --bg-surface: #121215;
            --bg-code: #18181c;
            --border-pure: #eeeeee;
            --border-subtle: #2a2a32;
            --text-master: #eeeeee;
            --text-muted: #aaaaaa;
            --gold-logo: #e5b82f;
            --gold-glow: rgba(229, 184, 47, 0.1);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background-color: var(--bg-master);
            color: var(--text-master);
            font-family: var(--font-editorial);
            font-size: 16px;
            line-height: 1.7;
            display: flex;
            min-height: 100vh;
            transition: background-color 0.2s ease, color 0.2s ease;
        }
        /* Navigazione Laterale Editoriale Restrittiva */
        nav {
            width: 300px;
            border-right: 1px solid var(--border-subtle);
            background-color: var(--bg-surface);
            padding: 50px 30px;
            display: flex;
            flex-direction: column;
            gap: 35px;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            z-index: 100;
            font-family: var(--font-mono);
        }

        .logo-area { padding-bottom: 25px; border-bottom: 1px solid var(--border-pure); }
        .logo-title { font-size: 1.25rem; font-weight: 800; letter-spacing: -0.5px; text-transform: uppercase; }
        .logo-subtitle { font-size: 0.7rem; color: var(--gold-logo); font-weight: bold; letter-spacing: 1.5px; margin-top: 6px; text-transform: uppercase; }

        .theme-toggle-container { display: flex; align-items: center; justify-content: space-between; padding: 10px; border: 1px solid var(--border-subtle); background: var(--bg-master); }
        .toggle-btn { background: none; border: none; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-master); cursor: pointer; font-weight: bold; text-transform: uppercase; width: 100%; text-align: center; padding: 4px 0; }

        .page-selector-container { display: flex; flex-direction: column; gap: 10px; }
        .selector-label { font-size: 0.65rem; font-weight: bold; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }
        select { width: 100%; font-family: var(--font-mono); padding: 12px; border: 1px solid var(--border-pure); background: var(--bg-master); color: var(--text-master); outline: none; cursor: pointer; font-size: 0.8rem; }

        .menu-list { display: flex; flex-direction: column; gap: 4px; list-style: none; }
        .menu-item { display: flex; align-items: center; padding: 12px 14px; font-size: 0.8rem; color: var(--text-muted); text-decoration: none; cursor: pointer; border: 1px solid transparent; }
        .menu-item:hover { color: var(--text-master); background-color: var(--bg-code); }
        .menu-item.active { color: var(--text-master); font-weight: bold; background-color: var(--gold-glow); border: 1px solid var(--gold-logo); border-left: 4px solid var(--gold-logo); }

        /* Struttura Centrale Editoriale Perfettamente Bilanciata */
        main { 
            margin-left: 300px; 
            width: calc(100% - 300px); 
            padding: 80px 100px; 
            display: flex; 
            flex-direction: column; 
            gap: 50px; 
            max-width: 1200px;
            align-items: center;
            text-align: center;
            margin-right: auto;
        }
        
        header, section, footer { width: 100%; max-width: 800px; text-align: center; }
        header { padding-bottom: 40px; border-bottom: 1px solid var(--border-subtle); display: flex; flex-direction: column; align-items: center; }
        header h1 { font-size: 2.4rem; font-weight: normal; letter-spacing: -1px; margin-bottom: 15px; color: var(--text-master); }
        .author-meta { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-master); margin-bottom: 25px; }
        .author-meta strong { color: var(--gold-logo); }
        .claim-quote { font-style: italic; font-size: 1.15rem; color: var(--text-muted); border-left: 2px solid var(--border-pure); border-right: 2px solid var(--border-pure); padding: 0 30px; margin: 20px 0; line-height: 1.8; text-align: center; }

        h2 { font-size: 1.5rem; font-weight: normal; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--border-pure); padding-bottom: 10px; margin-bottom: 25px; text-align: center; }
        .cert-monolith { background-color: var(--bg-surface); border: 1px solid var(--border-pure); padding: 30px; font-family: var(--font-mono); font-size: 0.9rem; text-align: center; }
        .cert-row { display: flex; flex-wrap: wrap; gap: 15px; margin-top: 20px; justify-content: center; }
        .cert-badge { background: var(--bg-code); padding: 6px 14px; border: 1px solid var(--border-subtle); font-weight: bold; font-size: 0.8rem; }

        .results-list { list-style: none; display: flex; flex-direction: column; gap: 35px; text-align: center; }
        .results-list li { padding: 0 20px; position: relative; display: flex; flex-direction: column; align-items: center; }
        .results-list p { color: var(--text-muted); margin-bottom: 15px; text-align: center; }
        .equation-box { background-color: var(--bg-code); border: 1px solid var(--border-subtle); padding: 20px; margin-top: 12px; width: 100%; overflow-x: auto; font-family: var(--font-editorial); font-size: 1.2rem; text-align: center; font-style: italic; }

        .artifact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; text-align: center; }
        .artifact-card { border: 1px solid var(--border-subtle); padding: 30px; background: var(--bg-surface); display: flex; flex-direction: column; justify-content: space-between; align-items: center; gap: 15px; }
        .artifact-card h4 { font-size: 1.15rem; font-weight: normal; color: var(--text-master); }
        .artifact-card p { font-size: 0.9rem; color: var(--text-muted); text-align: center; }
        .artifact-card a { color: var(--text-master); font-family: var(--font-mono); font-weight: bold; text-decoration: none; font-size: 0.8rem; text-transform: uppercase; border-bottom: 2px solid var(--gold-logo); padding-bottom: 2px; }

        footer { margin-top: auto; padding-top: 40px; border-top: 1px solid var(--border-subtle); font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 20px; }

        @media (max-width: 1000px) {
            body { flex-direction: column; }
            nav { width: 100%; height: auto; position: relative; padding: 30px 20px; border-right: none; border-bottom: 1px solid var(--border-subtle); }
            main { margin-left: 0; width: 100%; padding: 40px 20px; align-items: center; }
        }
    </style>
</head>
<body>

