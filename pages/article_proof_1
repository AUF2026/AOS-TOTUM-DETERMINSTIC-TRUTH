        <li class="tracking-item" onclick="navigateViaTrack('water_anomaly')">[02. Water]</li>
        <li class="tracking-item" onclick="navigateViaMenu('fine_structure')">[03. Alpha]</li>
        <li class="tracking-item" onclick="navigateViaTrack('fdm_dynamics')">[04. FDM]</li>
    </ul>

    <!-- MONOLITO CONTENUTI -->
