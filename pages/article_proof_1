        <div class="cert cert-gold">
            <ul>
                <li><a href="./public/AUF2026_Fine_Structure_Proof.pdf" target="_blank">Download Scientific Paper (PDF)</a></li>
                <li><a href="https://github.com" target="_blank">Browse Verified Lean 4 Core Code</a></li>
            </ul>
        </div>
    </div>
    <script>
        console.log("AUF2026 Layout Loaded. Style intact. Navigation Active.");

        // Inversione dinamica nativa dei contrasti cromatici
        function toggleFrameworkTheme() {
            const rootElement = document.documentElement;
            const currentTheme = rootElement.getAttribute('data-theme');
            const targetTheme = (currentTheme === 'dark') ? 'light' : 'dark';
            rootElement.setAttribute('data-theme', targetTheme);
            console.log("Theme switched to: " + targetTheme);
        }

        const pageRoutes = {
            'main_results': 'main_results.html',
            'water_anomaly': 'water_anomaly.html',
            'fine_structure': 'fine_structure.html',
            'fdm_dynamics': 'fdm_dynamics.html'
        };

        function syncTrackingUI(pageKey) {
            const trackingItems = document.querySelectorAll('#position-tracking-menu .tracking-item');
            const currentIndex = Object.keys(pageRoutes).indexOf(pageKey);
            
            trackingItems.forEach((item, index) => {
                if (index === currentIndex) { item.classList.add('active'); } 
                else { item.classList.remove('active'); }
            });
            document.getElementById('matrix-sector-dropdown').value = pageKey;
        }

        // Funzione asincrona Fetch per scambiare i frammenti della cartella /pages
        function loadMatrixSector(pageKey) {
            syncTrackingUI(pageKey);
            const targetUrl = './pages/' + pageRoutes[pageKey];
            
            fetch(targetUrl)
                .then(response => {
                    if (!response.ok) throw new Error("Awaiting segment integration in /pages...");
                    return response.text();
                })
                .then(htmlParziale => {
                    document.getElementById('content-container').innerHTML = htmlParziale;
                    if (window.MathJax) { window.MathJax.typesetPromise(); }
                })
                .catch(err => { console.log(err.message); });
        }

        function navigateViaTrack(pageKey) { loadMatrixSector(pageKey); }
        function navigateViaMenu(pageKey) { loadMatrixSector(pageKey); }
    </script>

